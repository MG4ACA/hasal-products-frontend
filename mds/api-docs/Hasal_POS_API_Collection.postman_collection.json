{
  "info": {
    "name": "Hasal POS API Collection",
    "description": "Complete API collection for Hasal Products POS System - Purchase Order Management with integrated return batch traceability",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "hasal-pos",
    "version": "2.1.0"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "supplier_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "material_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "po_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "batch_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "return_batch_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Login to get JWT token - Use for all protected endpoints"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('token', response.data.token);",
                  "    pm.environment.set('token', response.data.token);",
                  "    console.log('✅ Token saved');",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Purchase Orders",
      "description": "Create, retrieve, and manage purchase orders with receipt and return capabilities",
      "item": [
        {
          "name": "Create Purchase Order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"supplier_id\": {{supplier_id}},\n  \"order_date\": \"2026-01-15\",\n  \"expected_date\": \"2026-01-22\",\n  \"notes\": \"Test PO\",\n  \"items\": [\n    {\n      \"raw_material_id\": {{material_id}},\n      \"quantity\": 100,\n      \"unit_cost\": 50\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/purchase-orders",
              "host": ["{{base_url}}"],
              "path": ["api", "purchase-orders"]
            },
            "description": "Create new purchase order with items"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('po_id', response.data.id);",
                  "    console.log('✅ PO created with ID:', response.data.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Purchase Order",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/purchase-orders/{{po_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "purchase-orders", "{{po_id}}"]
            },
            "description": "Retrieve a specific purchase order with status and items"
          }
        },
        {
          "name": "Receive - Partial Receipt",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"received_date\": \"2026-01-15\",\n  \"received_items\": [\n    {\n      \"raw_material_id\": {{material_id}},\n      \"quantity_received\": 50,\n      \"expiry_date\": \"2027-01-15\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/purchase-orders/{{po_id}}/receive",
              "host": ["{{base_url}}"],
              "path": ["api", "purchase-orders", "{{po_id}}", "receive"]
            },
            "description": "Receive partial quantity - creates batch and updates PO status to 'partial'"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('batch_id', response.data.batches[0].id);",
                  "    console.log('✅ Partial receipt created, batch ID:', response.data.batches[0].id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Receive - Complete Receipt",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"received_date\": \"2026-01-15\",\n  \"received_items\": [\n    {\n      \"raw_material_id\": {{material_id}},\n      \"quantity_received\": 50,\n      \"expiry_date\": \"2027-01-15\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/purchase-orders/{{po_id}}/receive",
              "host": ["{{base_url}}"],
              "path": ["api", "purchase-orders", "{{po_id}}", "receive"]
            },
            "description": "Receive remaining quantity - updates PO status to 'received' after total matches"
          }
        },
        {
          "name": "Process Return",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"received_date\": \"2026-01-15\",\n  \"return_items\": [\n    {\n      \"raw_material_id\": {{material_id}},\n      \"quantity_returned\": 10,\n      \"return_reason\": \"Excess stock\",\n      \"disposition\": \"stock\",\n      \"source_batch_id\": {{batch_id}}\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/purchase-orders/{{po_id}}/receive",
              "host": ["{{base_url}}"],
              "path": ["api", "purchase-orders", "{{po_id}}", "receive"]
            },
            "description": "Process material return with source batch traceability - creates return batch linked to source receipt"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    const returnBatch = response.data.batches.find(b => b.batch_type === 'return');",
                  "    if (returnBatch) {",
                  "        pm.collectionVariables.set('return_batch_id', returnBatch.id);",
                  "        console.log('✅ Return batch created with ID:', returnBatch.id);",
                  "    }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Approve Batch Inspection",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"inspection_status\": \"approved\",\n  \"accepted_quantity\": 50,\n  \"inspection_notes\": \"Quality check passed. All units acceptable.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/raw-material-batches/{{batch_id}}/inspect",
              "host": ["{{base_url}}"],
              "path": ["api", "raw-material-batches", "{{batch_id}}", "inspect"]
            },
            "description": "Perform QC inspection and approve batch"
          }
        },
        {
          "name": "Cancel Purchase Order",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cancellation_reason\": \"Supplier unable to deliver on time\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/purchase-orders/{{po_id}}/cancel",
              "host": ["{{base_url}}"],
              "path": ["api", "purchase-orders", "{{po_id}}", "cancel"]
            },
            "description": "Cancel pending purchase order only"
          }
        }
      ]
    },
    {
      "name": "Batch Traceability Queries",
      "description": "Read-only queries for batch genealogy, return origin tracing, and material returns analysis",
      "item": [
        {
          "name": "Get Batch Genealogy",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/batches/{{batch_id}}/genealogy",
              "host": ["{{base_url}}"],
              "path": ["api", "batches", "{{batch_id}}", "genealogy"]
            },
            "description": "Get receipt batch with all associated returns and summary"
          }
        },
        {
          "name": "Trace Return Origin",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/batches/{{return_batch_id}}/origin",
              "host": ["{{base_url}}"],
              "path": ["api", "batches", "{{return_batch_id}}", "origin"]
            },
            "description": "Trace return batch back to its source receipt batch"
          }
        },
        {
          "name": "Get Material Returns Summary",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/batches/materials/{{material_id}}/returns-summary",
              "host": ["{{base_url}}"],
              "path": ["api", "batches", "materials", "{{material_id}}", "returns-summary"]
            },
            "description": "Get aggregated returns summary for material (total received, returned, net available)"
          }
        }
      ]
    },
    {
      "name": "Reference Data",
      "description": "Lookup endpoints for suppliers and materials",
      "item": [
        {
          "name": "List Suppliers",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/suppliers?limit=10",
              "host": ["{{base_url}}"],
              "path": ["api", "suppliers"],
              "query": [
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "List all suppliers"
          }
        },
        {
          "name": "List Raw Materials",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/raw-materials?limit=10",
              "host": ["{{base_url}}"],
              "path": ["api", "raw-materials"],
              "query": [
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "List all raw materials - use IDs for supplier_id and material_id"
          }
        }
      ]
    }
  ]
}
