{
  "openapi": "3.0.0",
  "info": {
    "title": "Hasal POS API",
    "description": "Complete API for Hasal Products POS System - Purchase Order Management with integrated return batch traceability",
    "version": "2.1.0",
    "contact": {
      "name": "API Support",
      "email": "support@hasal.com"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Development Server"
    }
  ],
  "securityDefinitions": {
    "bearerAuth": {
      "type": "apiKey",
      "scheme": "bearer",
      "bearerFormat": "JWT",
      "in": "header",
      "name": "Authorization"
    }
  },
  "paths": {
    "/health": {
      "get": {
        "tags": ["System"],
        "summary": "Health Check",
        "description": "Check if server is running",
        "responses": {
          "200": {
            "description": "Server is healthy"
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Login",
        "description": "Authenticate user and get JWT token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": {
                    "type": "string",
                    "example": "admin"
                  },
                  "password": {
                    "type": "string",
                    "example": "admin123"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "token": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/purchase-orders": {
      "post": {
        "tags": ["Purchase Orders"],
        "summary": "Create Purchase Order",
        "description": "Create new purchase order with items",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "supplier_id": {
                    "type": "integer"
                  },
                  "order_date": {
                    "type": "string",
                    "format": "date"
                  },
                  "expected_date": {
                    "type": "string",
                    "format": "date"
                  },
                  "notes": {
                    "type": "string"
                  },
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "raw_material_id": {
                          "type": "integer"
                        },
                        "quantity": {
                          "type": "number"
                        },
                        "unit_cost": {
                          "type": "number"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Purchase order created successfully"
          }
        }
      }
    },
    "/api/purchase-orders/{id}": {
      "get": {
        "tags": ["Purchase Orders"],
        "summary": "Get Purchase Order",
        "description": "Retrieve specific purchase order with items and status",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Purchase order details"
          },
          "404": {
            "description": "Purchase order not found"
          }
        }
      }
    },
    "/api/purchase-orders/{id}/receive": {
      "post": {
        "tags": ["Purchase Orders"],
        "summary": "Receive Purchase Order",
        "description": "Receive items for PO - supports partial receipts and returns with source_batch_id tracking",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "received_date": {
                    "type": "string",
                    "format": "date"
                  },
                  "received_items": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "raw_material_id": {
                          "type": "integer"
                        },
                        "quantity_received": {
                          "type": "number"
                        },
                        "expiry_date": {
                          "type": "string",
                          "format": "date"
                        }
                      }
                    }
                  },
                  "return_items": {
                    "type": "array",
                    "description": "Phase 2: Return items with source batch tracking",
                    "items": {
                      "type": "object",
                      "properties": {
                        "raw_material_id": {
                          "type": "integer"
                        },
                        "quantity_returned": {
                          "type": "number"
                        },
                        "return_reason": {
                          "type": "string"
                        },
                        "disposition": {
                          "type": "string",
                          "enum": ["stock", "dispose"]
                        },
                        "source_batch_id": {
                          "type": "integer",
                          "description": "Batch this return originated from"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Items received successfully"
          }
        }
      }
    },
    "/api/purchase-orders/{id}/cancel": {
      "patch": {
        "tags": ["Purchase Orders"],
        "summary": "Cancel Purchase Order",
        "description": "Cancel pending purchase order only",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "cancellation_reason": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Purchase order cancelled"
          }
        }
      }
    },
    "/api/raw-material-batches/{id}/inspect": {
      "patch": {
        "tags": ["Purchase Orders"],
        "summary": "Approve Batch Inspection",
        "description": "Perform QC inspection and approve/reject batch",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "inspection_status": {
                    "type": "string",
                    "enum": ["approved", "rejected"]
                  },
                  "accepted_quantity": {
                    "type": "number"
                  },
                  "rejected_quantity": {
                    "type": "number"
                  },
                  "inspection_notes": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Batch inspection completed"
          }
        }
      }
    },
    "/api/batches/{id}/genealogy": {
      "get": {
        "tags": ["Batch Traceability Queries"],
        "summary": "Get Batch Genealogy",
        "description": "Get receipt batch with all associated returns and summary information",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Receipt batch ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Batch genealogy with returns"
          },
          "400": {
            "description": "Only receipt batches supported"
          },
          "404": {
            "description": "Batch not found"
          }
        }
      }
    },
    "/api/batches/{id}/origin": {
      "get": {
        "tags": ["Batch Traceability Queries"],
        "summary": "Get Return Origin",
        "description": "Trace return batch back to its source receipt batch",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Return batch ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Return origin details"
          },
          "400": {
            "description": "Only return batches supported"
          },
          "404": {
            "description": "Batch not found"
          }
        }
      }
    },
    "/api/batches/materials/{materialId}/returns-summary": {
      "get": {
        "tags": ["Batch Traceability Queries"],
        "summary": "Material Returns Summary",
        "description": "Get aggregated returns summary for material (total received, returned, net available)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "materialId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Material returns summary with totals"
          },
          "404": {
            "description": "Material not found"
          }
        }
      }
    }
  }
}
